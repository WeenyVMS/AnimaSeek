<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  <TargetFramework>net10.0-ios</TargetFramework>
  <RootNamespace>AnimaSeek.iOS</RootNamespace>
  <AssemblyName>AnimaSeek</AssemblyName>
  <OutputType>Exe</OutputType>
  <Nullable>enable</Nullable>
  <ImplicitUsings>true</ImplicitUsings>
  <LangVersion>latest</LangVersion>

  <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  <TargetPlatformMinVersion>15.0</TargetPlatformMinVersion>
  <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>

  <Configurations>Debug;Debug Mock;Release;Release Mock</Configurations>
  <ApplicationTitle>AnimaSeek</ApplicationTitle>
  <ApplicationId>com.animaseek.app</ApplicationId>
  <ApplicationDisplayVersion>3.7.4</ApplicationDisplayVersion>
  <ApplicationVersion>136</ApplicationVersion>

  <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
</PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('Mock'))">
    <DefineConstants>
      $(DefineConstants);MOCK
    </DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('Release'))">
    <Optimize>true</Optimize>

    <!-- Compilation AOT et linker nécessaires pour une app iOS -->
    <TrimMode>full</TrimMode>
    <MtouchLink>Full</MtouchLink>

    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\Common\Common.csproj"
    />

    <ProjectReference
      Include="..\Seeker\Mono.Nat-master\Mono.Nat\Mono.Nat.csproj"
    />
  </ItemGroup>

  <ItemGroup>
    <!--
      Suppressions de trimming nécessaires pour MessagePack.

      _ILLinkSuppressions est une propriété interne du SDK.
      Le projet actuel utilise volontairement ce mécanisme avec
      le SDK .NET épinglé dans global.json.
    -->
    <_ILLinkSuppressions
      Include="$(MSBuildProjectDirectory)/MessagePack.TrimSuppressions.xml"
    />
  </ItemGroup>

  <ItemGroup>
    <!-- Licences et mentions obligatoires de Soulseek.NET -->
    <BundleResource
      Include="..\Seeker\Soulseek.NET-master\LICENSE"
      LogicalName="LICENSE"
    />

    <BundleResource
      Include="..\Seeker\Soulseek.NET-master\NOTICE"
      LogicalName="NOTICE"
    />

    <BundleResource
      Include="..\THIRD-PARTY-NOTICES"
      LogicalName="THIRD-PARTY-NOTICES"
    />

    <!-- Mentions des packages .NET et Microsoft.iOS -->
    <BundleResource
      Include="..\licenses\*"
      LogicalName="%(Filename)%(Extension)"
    />

    <!-- Images utilisées par le storyboard de lancement -->
    <BundleResource
      Include="Resources\LaunchSplash@2x.png"
      LogicalName="LaunchSplash@2x.png"
    />

    <BundleResource
      Include="Resources\LaunchSplash@3x.png"
      LogicalName="LaunchSplash@3x.png"
    />
  </ItemGroup>

</Project>
